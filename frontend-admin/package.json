{
  "name": "frontend-admin",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"nodemon server.js\" \"npm run watch:css\"",
    "watch:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./public/css/input.css -o ./public/css/output.css --minify",
    "start": "node server.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "axios": "^1.13.4",
    "cookie-parser": "^1.4.7",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0"
  }
}
